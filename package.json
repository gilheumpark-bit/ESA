{
  "name": "esva",
  "version": "0.2.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "description": "ESVA - Electrical Search Vertical AI: The Engineer's Search Engine",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.mjs",
    "predev": "npm run prepare:pdf-worker",
    "dev": "next dev --turbopack",
    "prebuild": "npm run prepare:pdf-worker",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "test:calc": "jest --testPathPatterns=calculators",
    "fixtures:drawings": "node scripts/fixtures/generate-drawings.mjs",
    "test:drawings": "jest --testPathPatterns=topology",
    "test:drawing-v3": "jest --runInBand src/agent/drawing src/app/api/drawing-jobs",
    "test:sld-benchmark": "jest --runInBand src/agent/drawing/__tests__/sld-benchmark-production.test.ts",
    "test:region-continuity": "node scripts/simulate-region-continuity.mjs",
    "test:scripts": "node --test scripts/lib/*.node-test.mjs",
    "validate:drawing-stages": "node scripts/run-drawing-reasoning-stages.mjs",
    "validate:drawing-model-matrix": "node scripts/run-drawing-model-matrix.mjs",
    "validate:drawing-effort-calibration": "node scripts/run-drawing-effort-calibration.mjs",
    "report:drawings": "jest --testPathPatterns=drawing-baseline --silent=false",
    "gate:pdf": "node scripts/pdf-fixture-gate.mjs",
    "gate:chat-live": "node scripts/chat-live-gate.mjs",
    "gate:chatgpt-local-live": "node scripts/chatgpt-local-live-gate.mjs",
    "gate:claude-local-live": "node scripts/claude-local-live-gate.mjs",
    "generate:sld-golden-receipt": "node scripts/sld-golden-gate.mjs --mode=receipt",
    "gate:sld-golden": "node scripts/sld-golden-gate.mjs --mode=enforce",
    "gate:sld-v3-contract": "jest --runInBand src/agent/drawing/__tests__/sld-evaluator-v2.test.ts",
    "test:sld-golden": "npm run gate:sld-golden",
    "gate:audit": "node scripts/audit-baseline-gate.mjs",
    "gate:snapshot": "node scripts/realworld-snapshot-freshness.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/deepseek": "^3.0.24",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/google-vertex": "^5.0.36",
    "@ai-sdk/mistral": "^4.0.25",
    "@ai-sdk/openai": "^4.0.16",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "@google/genai": "^2.16.0",
    "@napi-rs/canvas": "1.0.2",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.0.0",
    "ai": "^7.0.56",
    "clsx": "^2.1.0",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "firebase": "^12.17.1",
    "jose": "^6.2.4",
    "katex": "^0.18.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "sharp": "0.35.3",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.0.0",
    "weaviate-client": "^3.14.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@playwright/test": "^1.62.0",
    "@sentry/nextjs": "^10.46.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/analytics": "^2.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.1",
    "jest": "^30.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "0.35.3",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.26"
    }
  }
}
